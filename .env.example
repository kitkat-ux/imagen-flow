# ============================================================
# ImagenFlow — Docker Compose Environment Template
# Copy file này thành .env rồi điền giá trị thật vào
# cp .env.example .env
# ============================================================

# === BẮT BUỘC ===

# Fernet 32-byte key để mã hoá API key trong DB
# Tạo key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace-me-with-generated-fernet-key

# Địa chỉ frontend được phép gọi API (CORS)
# Local Docker test: http://localhost:8080
# VPS có IP: http://YOUR_VPS_IP:8080
# VPS có domain: https://yourdomain.com
CORS_ORIGINS=http://localhost:8080

# === TUỲ CHỌN ===

# Cloudinary — dùng cho Local Image node -> WeryAI I2I
# Nếu không dùng tính năng này, để trống
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=imagen-flow

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
