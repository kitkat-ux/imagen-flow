# Master key cho mã hoá API key trong DB (Fernet 32-byte base64)
# Generate bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace-me-with-generated-fernet-key

# Database URL
# Dev local SQLite (async):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Khi dùng Docker với Postgres, đổi thành:
# DATABASE_URL=postgresql+asyncpg://imagen:imagen@db:5432/imagen

# Đường dẫn lưu ảnh sinh ra
DATA_DIR=./data

# CORS - frontend origins được phép
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level
LOG_LEVEL=INFO

# Public image upload storage for Local Image -> WeryAI I2I
# Create an unsigned upload preset in Cloudinary, then fill these values.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=imagen-flow
